{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvanevski.github.io/firecrawl_skill/schemas/candidate-assessment-v1.json",
  "title": "CandidateAssessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "candidate-assessment-v1"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "relevance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unrelated",
        "uncertain"
      ]
    },
    "source_role": {
      "type": "string",
      "enum": [
        "primary",
        "controlling",
        "authoritative_secondary",
        "independent_secondary",
        "context_only",
        "unsuitable",
        "uncertain"
      ]
    },
    "target_question_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "target_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "freshness_assessment": {
      "$ref": "#/$defs/FreshnessAssessment"
    },
    "independence_assessment": {
      "$ref": "#/$defs/IndependenceAssessment"
    },
    "extraction_recommendation": {
      "type": "string",
      "enum": [
        "scrape",
        "metadata_only",
        "defer",
        "reject"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "relevance",
    "source_role",
    "target_question_ids",
    "target_claim_ids",
    "freshness_assessment",
    "independence_assessment",
    "extraction_recommendation",
    "priority",
    "rationale",
    "confidence",
    "uncertainty"
  ],
  "$defs": {
    "FreshnessAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "unsatisfied",
            "uncertain",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "rationale"
      ]
    },
    "IndependenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "independent",
            "dependent",
            "uncertain",
            "unassessed"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "status",
        "rationale"
      ]
    }
  }
}
