{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvanevski.github.io/firecrawl_skill/schemas/search-plan-v1.json",
  "title": "SearchPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "search-plan-v1"
    },
    "research_spec_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SearchQuery"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "research_spec_id",
    "revision",
    "queries"
  ],
  "$defs": {
    "SearchQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "type": "string",
          "format": "uuid"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "facet": {
          "type": "string",
          "minLength": 1
        },
        "target_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "target_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "intended_source_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_organizations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness_requirement": {
          "$ref": "#/$defs/TimeWindow"
        },
        "expected_contribution": {
          "type": "string",
          "minLength": 1
        },
        "domain_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "query_id",
        "query",
        "facet",
        "target_question_ids",
        "target_claim_ids",
        "intended_source_classes",
        "expected_organizations",
        "freshness_requirement",
        "expected_contribution",
        "domain_restrictions",
        "negative_terms",
        "priority"
      ]
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "description",
        "uncertainty"
      ]
    }
  }
}
