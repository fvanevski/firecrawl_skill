{
  "$id": "https://fvanevski.github.io/firecrawl_skill/schemas/smart-objective-intent-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartObjectiveIntent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "smart-objective-intent-v2", "type": "string"},
    "objective": {"minLength": 1, "type": "string"},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "entities": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "jurisdictions": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "user_constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "relative_freshness",
            "relative_publication_window",
            "absolute_publication_window",
            "event_window",
            "current_as_of",
            "conjunctive"
          ]
        },
        "relative_quantity": {"type": ["integer", "null"], "minimum": 1},
        "relative_unit": {"type": ["string", "null"], "enum": ["day", "week", null]},
        "freshness_basis": {
          "type": ["string", "null"],
          "enum": ["publication_or_update", "publication", null]
        },
        "temporal_basis": {
          "type": "string",
          "enum": [
            "none",
            "publication_within",
            "publication_or_update_within",
            "event_within",
            "current_as_of",
            "conjunctive"
          ]
        },
        "publication_start": {"type": ["string", "null"]},
        "publication_end": {"type": ["string", "null"]},
        "event_start": {"type": ["string", "null"]},
        "event_end": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"]},
        "uncertainty": {"type": "string", "enum": ["none", "ambiguous", "unsupported"]},
        "rationale": {"type": "string"}
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "none"},
            "relative_quantity": {"type": "null"},
            "relative_unit": {"type": "null"},
            "freshness_basis": {"type": "null"},
            "temporal_basis": {"const": "none"},
            "publication_start": {"type": "null"},
            "publication_end": {"type": "null"},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "null"},
            "uncertainty": {"type": "string", "enum": ["none", "ambiguous", "unsupported"]},
            "rationale": {"type": "string"}
          },
          "required": ["kind", "relative_quantity", "relative_unit", "freshness_basis", "temporal_basis", "publication_start", "publication_end", "event_start", "event_end", "as_of", "uncertainty", "rationale"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "relative_freshness"},
            "relative_quantity": {"type": "integer", "minimum": 1},
            "relative_unit": {"enum": ["day", "week"]},
            "freshness_basis": {"const": "publication_or_update"},
            "temporal_basis": {"const": "publication_or_update_within"},
            "publication_start": {"type": "null"},
            "publication_end": {"type": "null"},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "null"},
            "uncertainty": {"type": "string", "enum": ["none", "ambiguous", "unsupported"]},
            "rationale": {"type": "string"}
          },
          "required": ["kind", "relative_quantity", "relative_unit", "freshness_basis", "temporal_basis", "publication_start", "publication_end", "event_start", "event_end", "as_of", "uncertainty", "rationale"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "relative_publication_window"},
            "relative_quantity": {"type": "integer", "minimum": 1},
            "relative_unit": {"enum": ["day", "week"]},
            "freshness_basis": {"const": "publication"},
            "temporal_basis": {"const": "publication_within"},
            "publication_start": {"type": "null"},
            "publication_end": {"type": "null"},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "null"},
            "uncertainty": {"type": "string", "enum": ["none", "ambiguous", "unsupported"]},
            "rationale": {"type": "string"}
          },
          "required": ["kind", "relative_quantity", "relative_unit", "freshness_basis", "temporal_basis", "publication_start", "publication_end", "event_start", "event_end", "as_of", "uncertainty", "rationale"]
        },
        {
          "properties": {
            "kind": {"const": "absolute_publication_window"},
            "relative_quantity": {"type": "null"},
            "relative_unit": {"type": "null"},
            "freshness_basis": {"type": "null"},
            "temporal_basis": {"const": "publication_within"},
            "publication_start": {"type": "string", "minLength": 1},
            "publication_end": {"type": "string", "minLength": 1},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "null"}
          }
        },
        {
          "properties": {
            "kind": {"const": "event_window"},
            "relative_quantity": {"type": "null"},
            "relative_unit": {"type": "null"},
            "freshness_basis": {"type": "null"},
            "temporal_basis": {"const": "event_within"},
            "publication_start": {"type": "null"},
            "publication_end": {"type": "null"},
            "event_start": {"type": "string", "minLength": 1},
            "event_end": {"type": "string", "minLength": 1},
            "as_of": {"type": "null"}
          }
        },
        {
          "properties": {
            "kind": {"const": "current_as_of"},
            "relative_quantity": {"type": "null"},
            "relative_unit": {"type": "null"},
            "freshness_basis": {"type": "null"},
            "temporal_basis": {"const": "current_as_of"},
            "publication_start": {"type": "null"},
            "publication_end": {"type": "null"},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "kind": {"const": "conjunctive"},
            "relative_quantity": {"type": "integer", "minimum": 1},
            "relative_unit": {"enum": ["day", "week"]},
            "freshness_basis": {"const": "publication_or_update"},
            "temporal_basis": {"const": "conjunctive"},
            "publication_start": {"type": "string", "minLength": 1},
            "publication_end": {"type": "string", "minLength": 1},
            "event_start": {"type": "null"},
            "event_end": {"type": "null"},
            "as_of": {"type": "null"}
          }
        }
      ],
      "required": [
        "kind",
        "relative_quantity",
        "relative_unit",
        "freshness_basis",
        "temporal_basis",
        "publication_start",
        "publication_end",
        "event_start",
        "event_end",
        "as_of",
        "uncertainty",
        "rationale"
      ]
    },
    "assumptions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "required": [
    "schema_version",
    "objective",
    "research_questions",
    "entities",
    "jurisdictions",
    "user_constraints",
    "temporal",
    "assumptions",
    "ambiguities"
  ]
}
