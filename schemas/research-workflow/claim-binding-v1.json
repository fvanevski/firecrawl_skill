{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claim-binding-v1",
  "title": "Claim Binding Output",
  "type": "object",
  "properties": {
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid",
            "description": "The exact claim_id from the input EvidencePacket."
          },
          "semantic_status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "qualified",
              "unsupported",
              "uncertain",
              "unassessed"
            ],
            "description": "The determined semantic status for this claim based on the passages."
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passage_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1,
                  "description": "The exact passage IDs that form this binding."
                },
                "relationship": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "contradicts",
                    "qualifies",
                    "context"
                  ],
                  "description": "The role of the selected passages towards the claim."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Model confidence (0.0 to 1.0)."
                },
                "uncertainty": {
                  "type": "string",
                  "description": "Explanation of any uncertainty or missing corroboration."
                }
              },
              "required": [
                "passage_ids",
                "relationship",
                "confidence",
                "uncertainty"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "claim_id",
          "semantic_status",
          "bindings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "evaluations"
  ],
  "additionalProperties": false
}
