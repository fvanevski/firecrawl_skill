{
  "$id": "research-result-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research controller result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "research-result-v3"},
    "run_id": {"type": "string", "pattern": "^fr_[0-9a-fA-F]{32}$"},
    "objective": {"type": "string", "minLength": 1},
    "lifecycle_state": {"type": "string", "minLength": 1},
    "lifecycle_revision": {"type": "integer", "minimum": 0},
    "disposition": {"enum": ["continue_automatic", "operator_action_required", "terminal_completed", "terminal_partial", "blocked", "failed", "cancelled"]},
    "terminal": {"type": "boolean"},
    "outcome": {"type": ["string", "null"]},
    "result_ready": {"type": "boolean"},
    "handoff_ready": {"type": "boolean"},
    "objective_satisfied": {"type": "boolean"},
    "delivery_mode": {"type": ["string", "null"], "enum": ["host_handoff", "self_synthesized", null]},
    "handoff": {"type": ["object", "null"]},
    "action_kind": {"type": ["string", "null"]},
    "action_id": {"type": ["string", "null"], "pattern": "^oa_[0-9a-f]{32}$"},
    "diagnostics": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 500}},
    "limitations": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 500}}
  },
  "required": ["schema_version", "run_id", "objective", "lifecycle_state", "lifecycle_revision", "disposition", "terminal", "outcome", "result_ready", "handoff_ready", "objective_satisfied", "delivery_mode", "handoff", "action_kind", "action_id", "diagnostics", "limitations"]
}
