{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvanevski.github.io/firecrawl_skill/schemas/evidence-packet-v1.json",
  "title": "EvidencePacket",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "evidence-packet-v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "research_spec_id": {
      "type": "string",
      "format": "uuid"
    },
    "coverage_revision": {
      "type": "integer"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidencePassage"
      }
    },
    "omitted_passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidencePassage"
      }
    },
    "claim_evidence_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimEvidenceBinding"
      }
    },
    "corroborating_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceGroup"
      }
    },
    "contradicting_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceGroup"
      }
    },
    "qualifying_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceGroup"
      }
    },
    "near_duplicate_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceGroup"
      }
    },
    "source_diversity_summary": {
      "type": "object",
      "additionalProperties": {}
    },
    "freshness_summary": {
      "type": "object",
      "additionalProperties": {}
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "independence_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IndependenceAssessment"
      }
    },
    "retrieval_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RetrievalProvenance"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "research_spec_id",
    "coverage_revision",
    "claims",
    "passages",
    "omitted_passages",
    "claim_evidence_bindings",
    "corroborating_groups",
    "contradicting_groups",
    "qualifying_groups",
    "near_duplicate_groups",
    "source_diversity_summary",
    "freshness_summary",
    "limitations",
    "unresolved_items",
    "independence_assessments",
    "retrieval_provenance"
  ],
  "$defs": {
    "ClaimEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "passage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "relationship": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "qualifies",
            "context"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "input_packet_revision": {
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "claim_id",
        "passage_ids",
        "relationship",
        "confidence",
        "uncertainty",
        "model",
        "prompt_version",
        "schema_version",
        "input_packet_revision"
      ]
    },
    "EvidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "statement": {
          "type": "string"
        },
        "semantic_status": {
          "type": "string",
          "enum": [
            "supported",
            "contradicted",
            "qualified",
            "unsupported",
            "uncertain",
            "unassessed"
          ]
        },
        "uncertainty": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "semantic_status",
        "uncertainty"
      ]
    },
    "EvidenceGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "passage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rationale": {
          "type": "string"
        },
        "evaluated": {
          "type": "boolean"
        }
      },
      "required": [
        "group_id",
        "passage_ids",
        "rationale",
        "evaluated"
      ]
    },
    "EvidencePassage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passage_id": {
          "type": "string",
          "format": "uuid"
        },
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "chunk_id": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "candidate_id",
        "snapshot_id",
        "chunk_id",
        "text",
        "source_url"
      ]
    },
    "IndependenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "independent",
            "dependent",
            "uncertain",
            "unassessed"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "status",
        "rationale"
      ]
    },
    "MechanicalFailure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_id": {
          "type": "string",
          "format": "uuid"
        },
        "component": {
          "type": "string"
        },
        "error_class": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "degraded",
            "failed",
            "unavailable"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "failure_id",
        "component",
        "error_class",
        "message",
        "status",
        "retryable"
      ]
    },
    "RetrievalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retrieval_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "requested_mode": {
          "type": "string"
        },
        "executed_mode": {
          "type": "string"
        },
        "mechanical_status": {
          "type": "string",
          "enum": [
            "succeeded",
            "degraded",
            "failed",
            "unavailable"
          ]
        },
        "component_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MechanicalFailure"
          }
        },
        "selected_passage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "retrieval_event_id",
        "requested_mode",
        "executed_mode",
        "mechanical_status",
        "component_errors",
        "selected_passage_ids"
      ]
    }
  }
}
