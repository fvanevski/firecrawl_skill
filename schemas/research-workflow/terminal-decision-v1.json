{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvanevski.github.io/firecrawl_skill/schemas/terminal-decision-v1.json",
  "title": "TerminalDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "terminal-decision-v1"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_revision": {
      "type": "integer"
    },
    "coverage_revision": {
      "type": "integer"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "sufficient",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "no_progress_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "no_new_candidates",
          "no_new_assets",
          "no_changed_coverage",
          "repeated_equivalent_proposals",
          "repeated_extraction_failures",
          "repeated_retrieval",
          "cost_budget_exhausted",
          "wall_clock_exhausted",
          "unsatisfiable_source"
        ]
      }
    },
    "unresolved_gap": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "run_revision",
    "coverage_revision",
    "outcome",
    "no_progress_signals",
    "unresolved_gap",
    "policy_version",
    "created_at"
  ],
  "$defs": {}
}
