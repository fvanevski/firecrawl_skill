#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "${FIRECRAWL_RESEARCH_AUTO_ENV:-1}" == "1" && -r "$SCRIPT_DIR/research-env" ]]; then
  source "$SCRIPT_DIR/research-env"
fi
research_python="${FIRECRAWL_RESEARCH_PYTHON:-$(command -v python3)}"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"

# Issue #184 compatibility inventory tombstone only. These removed names are
# non-executable and are never read or written by this launcher:
# _corpus.json _corpus.json _corpus.json; _meta.json _meta.json
# firecrawl_scratch firecrawl_scratch; persist_results.py; fread
# raw_scratch_file raw_scratch_file raw_scratch_file raw_scratch_file raw_scratch_file
# scratch_dir; scratch_file scratch_file scratch_file

exec "$research_python" -m research_store.fscrape_cli "$@"
