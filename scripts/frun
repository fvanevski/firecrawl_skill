#!/usr/bin/env bash
# frun — PostgreSQL-authoritative Firecrawl research-run lifecycle.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "${FIRECRAWL_RESEARCH_AUTO_ENV:-1}" == "1" && -r "$SCRIPT_DIR/research-env" ]]; then
  source "$SCRIPT_DIR/research-env"
fi

[[ -n "${DATABASE_URL:-}" ]] || {
  echo "ERROR: frun requires the authoritative PostgreSQL store" >&2
  exit 1
}

"$SCRIPT_DIR/research-db" ingest-ready >/dev/null

usage() {
  cat >&2 <<'USAGE'
Usage:
  frun start <objective> [--run-mode autonomous|curated]
       [--mode agent_led|autonomous_local|deterministic_debug]
  frun prepare <fr_id>
  frun assets <fr_id>
  frun retain <fr_id> <promotion_subject_id> [--reason TEXT]
  frun reject <fr_id> <promotion_subject_id> --reason TEXT
  frun seal-acquisition <fr_id>
  frun resume <fr_id> [--batch-size N] [--max-batches N]
       [--deadline-seconds N] [--initial-backoff-seconds N]
       [--max-backoff-seconds N]
  frun finish <fr_id> --outcome <satisfied|partial|...> [--status complete|failed]
       [--source-manifest FILE] [--answer-file FILE] [--auto-audit]
  frun reopen <fr_id> [--reason TEXT]
  frun cancel <fr_id> [--reason TEXT]
  frun annotate <fr_id> --type pivot|retry|decision --reason TEXT
  frun status <fr_id>
  frun verify <fr_id>
  frun integrity <fr_id> [--output FILE]
  frun audit <fr_id> [audit options]
  frun audit-status <fr_id>
  frun compare <fr_id> [fr_id ...]
USAGE
  exit 2
}

case "${1:-}" in
  start)
    shift
    objective="${1:-}"
    [[ -n "$objective" ]] || usage
    shift
    execution_mode="autonomous_local"
    run_mode="autonomous"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --mode) execution_mode="$2"; shift 2 ;;
        --run-mode) run_mode="$2"; shift 2 ;;
        *) echo "ERROR: unknown start option: $1" >&2; exit 2 ;;
      esac
    done
    case "$execution_mode" in
      agent_led|autonomous_local|deterministic_debug) ;;
      *) echo "ERROR: unsupported execution mode: $execution_mode" >&2; exit 2 ;;
    esac
    case "$run_mode" in
      autonomous|curated) ;;
      *) echo "ERROR: unsupported run mode: $run_mode" >&2; exit 2 ;;
    esac
    output="$(
      python3 "$SCRIPT_DIR/curated_run_cli.py" start "$objective" \
        --run-mode "$run_mode" --mode "$execution_mode"
    )"
    python3 -c 'import json,sys; print(json.load(sys.stdin)["external_id"])' <<<"$output"
    ;;

  prepare)
    shift
    exec python3 "$SCRIPT_DIR/curated_run_cli.py" prepare "$@"
    ;;

  assets)
    shift
    exec python3 "$SCRIPT_DIR/curated_run_cli.py" assets "$@"
    ;;

  retain)
    shift
    exec python3 "$SCRIPT_DIR/curated_run_cli.py" retain "$@"
    ;;

  reject)
    shift
    exec python3 "$SCRIPT_DIR/curated_run_cli.py" reject "$@"
    ;;

  seal-acquisition)
    shift
    exec python3 "$SCRIPT_DIR/curated_run_cli.py" seal-acquisition "$@"
    ;;

  resume)
    shift
    run_id="${1:-}"
    [[ -n "$run_id" ]] || usage
    shift
    args=("$run_id")
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --batch-size|--max-batches|--deadline-seconds|--initial-backoff-seconds|--max-backoff-seconds)
          [[ $# -ge 2 ]] || { echo "ERROR: $1 requires a value" >&2; exit 2; }
          args+=("$1" "$2")
          shift 2
          ;;
        *) echo "ERROR: unknown resume option: $1" >&2; exit 2 ;;
      esac
    done
    resume_status="$(python3 "$SCRIPT_DIR/curated_run_cli.py" resume "$run_id")"
    read -r persisted_run_mode checkpoint_ready < <(
      python3 -c '
import json,sys
data=json.load(sys.stdin)
print(data["run_mode"], int(data.get("next_action") == "resume index checkpoint"))
' <<<"$resume_status"
    )
    if [[ "$persisted_run_mode" == "curated" && "$checkpoint_ready" != "1" ]]; then
      printf '%s\n' "$resume_status"
      exit 0
    fi
    exec python3 "$SCRIPT_DIR/resume_index_checkpoint.py" "${args[@]}"
    ;;

  finish)
    shift
    run_id="${1:-}"
    [[ -n "$run_id" ]] || usage
    shift
    outcome=""
    status="complete"
    source_manifest=""
    answer_file=""
    auto_audit=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --outcome) outcome="$2"; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --source-manifest) source_manifest="$2"; shift 2 ;;
        --answer-file) answer_file="$2"; shift 2 ;;
        --auto-audit) auto_audit=1; shift ;;
        *) echo "ERROR: unknown finish option: $1" >&2; exit 2 ;;
      esac
    done
    [[ -n "$outcome" ]] || { echo "ERROR: --outcome is required" >&2; exit 2; }
    source_sha=""
    answer_sha=""
    if [[ -n "$source_manifest" ]]; then
      [[ -f "$source_manifest" ]] || { echo "ERROR: source manifest not found: $source_manifest" >&2; exit 1; }
      source_sha="$(sha256sum "$source_manifest" | awk '{print $1}')"
    fi
    if [[ -n "$answer_file" ]]; then
      [[ -f "$answer_file" ]] || { echo "ERROR: answer file not found: $answer_file" >&2; exit 1; }
      answer_sha="$(sha256sum "$answer_file" | awk '{print $1}')"
    fi
    mode_json="$(python3 "$SCRIPT_DIR/curated_run_cli.py" mode "$run_id")"
    persisted_run_mode="$(
      python3 -c 'import json,sys; print(json.load(sys.stdin)["run_mode"])' <<<"$mode_json"
    )"
    if [[ "$persisted_run_mode" == "curated" ]]; then
      args=(finish "$run_id" --outcome "$outcome" --status "$status")
      [[ -z "$source_sha" ]] || args+=(--source-manifest-sha256 "$source_sha")
      [[ -z "$answer_sha" ]] || args+=(--answer-sha256 "$answer_sha")
      python3 "$SCRIPT_DIR/curated_run_cli.py" "${args[@]}" >/dev/null
    else
      args=(run-finish "$run_id" --outcome "$outcome" --status "$status")
      [[ -z "$source_sha" ]] || args+=(--source-manifest-sha256 "$source_sha")
      [[ -z "$answer_sha" ]] || args+=(--answer-sha256 "$answer_sha")
      "$SCRIPT_DIR/research-db" "${args[@]}" >/dev/null
    fi
    printf '%s\n' "$run_id"
    if (( auto_audit )); then
      "$SCRIPT_DIR/research-db" run-audit "$run_id"
    fi
    ;;

  reopen)
    shift
    exec "$SCRIPT_DIR/research-db" run-reopen "$@"
    ;;
  cancel)
    shift
    exec "$SCRIPT_DIR/research-db" run-cancel "$@"
    ;;
  annotate)
    shift
    exec "$SCRIPT_DIR/research-db" run-annotate "$@"
    ;;
  status|show)
    shift
    exec "$SCRIPT_DIR/research-db" run-status "$@"
    ;;
  verify)
    shift
    exec "$SCRIPT_DIR/research-db" run-verify "$@"
    ;;
  integrity)
    shift
    run_id="${1:-}"
    [[ -n "$run_id" ]] || usage
    shift
    output=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --output)
          [[ $# -ge 2 ]] || { echo "ERROR: --output requires a value" >&2; exit 2; }
          output="$2"
          shift 2
          ;;
        *) echo "ERROR: unknown integrity option: $1" >&2; exit 2 ;;
      esac
    done
    if [[ -z "$output" ]]; then
      safe_run_id="${run_id//[^A-Za-z0-9_.-]/_}"
      output="./${safe_run_id}.integrity.json"
    fi
    exec "$SCRIPT_DIR/research-db" integrity "$run_id" --output "$output"
    ;;
  audit)
    shift
    exec "$SCRIPT_DIR/research-db" run-audit "$@"
    ;;
  audit-status)
    shift
    exec "$SCRIPT_DIR/research-db" audit-status "$@"
    ;;
  compare)
    shift
    exec "$SCRIPT_DIR/research-db" run-compare "$@"
    ;;
  *) usage ;;
esac
