#!/usr/bin/env python3
"""Compare recorded site-scoped and unscoped planner yield without network I/O."""

from __future__ import annotations

import argparse
import json
import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(SCRIPT_DIR), "src"))

from firecrawl_skill.research_store.planner_yield_diagnostic import (
    compare_planner_yield,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--scoped-query", required=True)
    parser.add_argument("--unscoped-query", required=True)
    parser.add_argument("--scoped-count", type=int, required=True)
    parser.add_argument("--unscoped-count", type=int, required=True)
    parser.add_argument(
        "--planner-provenance-json",
        default="{}",
        help="JSON object copied from the persisted/planner diagnostic provenance",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    provenance = json.loads(args.planner_provenance_json)
    if not isinstance(provenance, dict):
        raise SystemExit("--planner-provenance-json must decode to an object")
    payload = compare_planner_yield(
        scoped_query=args.scoped_query,
        unscoped_query=args.unscoped_query,
        scoped_candidate_count=args.scoped_count,
        unscoped_candidate_count=args.unscoped_count,
        planner_provenance=provenance,
    )
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
