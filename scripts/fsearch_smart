#!/usr/bin/env python3
"""PostgreSQL-authoritative coverage-led smart search."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

SCRIPT_DIR = os.environ.get("FIRECRAWL_SKILL_SCRIPT_DIR") or os.path.dirname(
    os.path.realpath(__file__)
)
sys.path.insert(0, SCRIPT_DIR)
sys.path.insert(0, os.path.join(os.path.dirname(SCRIPT_DIR), "src"))

import research_workflow as workflow
from invocation_id import resolve_invocation_id

from firecrawl_skill.research_domain import load_model, serialize_model
from firecrawl_skill.research_domain.models import ExecutionMode, ResearchSpec
from firecrawl_skill.research_store.fallback_temporal_spec import (
    materialize_smart_fallback_spec,
)
from firecrawl_skill.research_store.smart_search_application import (
    deterministic_queries,
    evaluate_budget,
    initialize_planning_bundle,
)

CHECKPOINT_EXIT = 75


def resolved_research_environment() -> dict[str, str]:
    environment = os.environ.copy()
    if environment.get("FIRECRAWL_RESEARCH_AUTO_ENV", "1") != "1":
        return environment
    adapter = os.path.join(SCRIPT_DIR, "research-env")
    if not os.path.isfile(adapter):
        return environment
    result = subprocess.run(
        ["bash", "-c", 'source "$1"; env -0', "research-env", adapter],
        check=True,
        capture_output=True,
    )
    return {
        key.decode(errors="surrogateescape"): value.decode(errors="surrogateescape")
        for entry in result.stdout.split(b"\0")
        if entry
        for key, value in [entry.split(b"=", 1)]
    }


@contextmanager
def applied_environment(environment: dict[str, str]):
    previous = os.environ.copy()
    os.environ.clear()
    os.environ.update(environment)
    try:
        yield
    finally:
        os.environ.clear()
        os.environ.update(previous)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("topic")
    parser.add_argument("--research-spec")
    parser.add_argument("--invocation-id")
    parser.add_argument(
        "--research-run-id",
        default=os.environ.get("FIRECRAWL_RESEARCH_RUN_ID", ""),
    )
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--max-adaptive-cycles", type=int)
    parser.add_argument(
        "--stop-after-state",
        choices=(
            "planning",
            "corpus_review",
            "acquiring",
            "extracting",
            "indexing",
            "coverage_review",
            "synthesizing",
            "validating",
        ),
        default=os.environ.get("FIRECRAWL_SMART_STOP_AFTER_STATE") or None,
        help=argparse.SUPPRESS,
    )
    return parser


def load_spec(
    path: str | None,
    topic: str,
    *,
    execution_mode: ExecutionMode | str,
    evaluated_at: datetime,
) -> tuple[ResearchSpec, str]:
    if path:
        value = load_model(json.loads(Path(path).read_text(encoding="utf-8")))
        if not isinstance(value, ResearchSpec):
            raise ValueError("--research-spec must contain research-spec-v1")
        return value, "explicit"
    return (
        materialize_smart_fallback_spec(
            topic,
            execution_mode=execution_mode,
            evaluated_at=evaluated_at,
        ),
        "conservative fallback",
    )


def workflow_query_planner(
    topic: str,
    max_queries: int,
    semantic_persistence: Any,
    semantic_context: dict[str, Any],
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    """Adapt operator planner tooling to the installed application boundary."""
    brief = workflow.conservative_brief(topic, "general")
    return workflow.plan_queries(
        topic,
        brief,
        max_queries,
        "local",
        None,
        None,
        None,
        semantic_persistence=semantic_persistence,
        semantic_context=semantic_context,
    )


def resolve_cycles(
    requested: int | None,
    budget: dict[str, Any],
    parser: argparse.ArgumentParser,
) -> int:
    cap = int(budget.get("effective_caps", {}).get("max_adaptive_cycles", 0))
    if cap < 1:
        parser.error("authoritative budget has no adaptive-cycle allowance")
    if requested is None:
        return cap
    if requested < 1 or requested > cap:
        parser.error(f"--max-adaptive-cycles must be between 1 and {cap}")
    return requested


def ensure_run(run_id: str, topic: str, environment: dict[str, str]) -> str:
    if run_id:
        return run_id
    result = subprocess.run(
        [os.path.join(SCRIPT_DIR, "frun"), "start", topic],
        env=environment,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "failed to create research run")
    return result.stdout.strip()


def prepare_run(run_id: str, topic: str, environment: dict[str, str]):
    if not environment.get("DATABASE_URL"):
        raise RuntimeError("DATABASE_URL is required")
    ready = subprocess.run(
        [os.path.join(SCRIPT_DIR, "research-db"), "ingest-ready"],
        env=environment,
        check=False,
        capture_output=True,
        text=True,
    )
    if ready.returncode:
        raise RuntimeError(ready.stderr.strip() or "authoritative store is not ready")

    from firecrawl_skill.research_store.acquisition.authority import (
        ACQUISITION_ENTRY_STATES,
        require_authoritative_acquisition,
    )
    from firecrawl_skill.research_store.composition import build_run_service
    from firecrawl_skill.research_store.config import StoreConfig

    external_id = ensure_run(run_id, topic, environment)
    config = StoreConfig.from_env()
    config.require_database()
    service = build_run_service(config)
    status = service.status(external_id=external_id)
    if status.state in ACQUISITION_ENTRY_STATES:
        require_authoritative_acquisition(run_id=status.id, config=config)
    return external_id, config, service, status


def execute(
    external_id: str,
    config: Any,
    bundle: Any,
    cycles: int,
    stop_after_state: str | None,
):
    from firecrawl_skill.research_store.composition import (
        build_production_resumable_orchestrator,
    )
    from firecrawl_skill.research_store.orchestrator import OrchestratorConfig

    orchestrator = build_production_resumable_orchestrator(
        config,
        orchestrator_config=OrchestratorConfig(
            execution_mode="autonomous_local",
            budget_policy_version=bundle.budget["policy_version"],
            max_adaptive_cycles=cycles,
        ),
    )
    return orchestrator.run_from_external_id(
        external_id,
        spec=serialize_model(bundle.spec),
        search_plan=bundle.plan,
        max_adaptive_cycles=cycles,
        context={
            ContextKey: value
            for ContextKey, value in {
                "spec_id": str(bundle.spec_row_id),
                "spec_revision": bundle.spec_revision,
                "search_plan_id": str(bundle.plan_row_id),
                "search_plan_revision": bundle.plan_revision,
                "authoritative_budget": bundle.budget,
                "_stop_after_state": stop_after_state,
            }.items()
        },
    )


def dry_run(
    topic: str,
    invocation_id: str,
    spec: ResearchSpec,
    budget: dict[str, Any],
) -> dict[str, Any]:
    queries, provenance = deterministic_queries(topic)
    return {
        "schema_version": "authoritative-smart-search-plan-v1",
        "mode": "dry_run",
        "topic": topic,
        "invocation_id": invocation_id,
        "research_spec": serialize_model(spec),
        "budget_snapshot": budget,
        "planner": "orchestrator",
        "planner_provenance": provenance,
        "strategy": {"acquisition_mode": "coverage_led_orchestrator"},
        "queries": queries,
    }


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    evaluated_at = datetime.now(timezone.utc)
    try:
        invocation_id = resolve_invocation_id(args.invocation_id)
    except ValueError as exc:
        parser.error(str(exc))

    if args.dry_run:
        try:
            spec, _ = load_spec(
                args.research_spec,
                args.topic,
                execution_mode=ExecutionMode.AUTONOMOUS_LOCAL,
                evaluated_at=evaluated_at,
            )
            budget = evaluate_budget(spec, 0)
            cycles = resolve_cycles(args.max_adaptive_cycles, budget, parser)
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            parser.error(str(exc))
        payload = dry_run(args.topic, invocation_id, spec, budget)
        payload["strategy"]["max_adaptive_cycles"] = cycles
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0

    try:
        environment = resolved_research_environment()
        with applied_environment(environment):
            external_id, config, service, status = prepare_run(
                args.research_run_id, args.topic, environment
            )
            from firecrawl_skill.research_store.smart_orchestrator import (
                load_planning_bundle,
            )

            bundle = load_planning_bundle(service, status.id)
            source = "persisted"
            if bundle is None:
                if status.state not in {"created", "planning"}:
                    raise RuntimeError(
                        f"run in {status.state} has no complete planning tuple"
                    )
                spec, source = load_spec(
                    args.research_spec,
                    args.topic,
                    execution_mode=status.execution_mode,
                    evaluated_at=evaluated_at,
                )
                bundle = initialize_planning_bundle(
                    service,
                    status,
                    topic=args.topic,
                    spec=spec,
                    invocation_id=invocation_id,
                    planner=workflow_query_planner,
                )
            elif args.research_spec:
                supplied, _ = load_spec(
                    args.research_spec,
                    args.topic,
                    execution_mode=status.execution_mode,
                    evaluated_at=evaluated_at,
                )
                if serialize_model(supplied) != serialize_model(bundle.spec):
                    parser.error("--research-spec conflicts with persisted records")
            cycles = resolve_cycles(args.max_adaptive_cycles, bundle.budget, parser)
            result = execute(external_id, config, bundle, cycles, args.stop_after_state)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        parser.error(str(exc))

    print(f"Topic: {bundle.spec.objective}")
    print(f"Run ID: {external_id}")
    print(f"Planning source: {source}")
    print(f"Orchestrator outcome: {result.outcome}")
    print(f"Final state: {result.final_state}")
    print(f"Wave count: {result.wave_count}")
    print(f"Successful URLs: {result.successful_urls}")
    if result.outcome == "checkpoint":
        return CHECKPOINT_EXIT
    if result.error:
        print(f"Error: {result.error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
