#!/usr/bin/env python3
# fsearch_smart — Advanced automated multi-query search orchestrator for Firecrawl
#
# Usage:
#   fsearch_smart "<topic>" [--research-spec spec.json] [--research-run-id fr_<uuid>]
#
# DEPRECATION NOTE (P7-08 / #68):
#   The monolithic legacy loop has been retired. The coverage-led
#   ResearchOrchestrator is now the default and only execution path.
#   Legacy flags (--planner, --llm, --complexity, --research-profile,
#   --commercial-fallback, --fallback-model, --no-llm-triage) are
#   accepted for CLI compatibility but have no effect.
#

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit

SCRIPT_DIR = os.environ.get("FIRECRAWL_SKILL_SCRIPT_DIR") or os.path.dirname(
    os.path.realpath(__file__)
)
sys.path.insert(0, SCRIPT_DIR)
import invocation_catalog as catalog
import research_workflow as workflow
from budget_policy import DEFAULT_POLICY, conservative_research_spec
from invocation_id import resolve_invocation_id
from research_domain import load_model, serialize_model
from research_domain.models import ResearchSpec


def resolved_research_environment() -> dict[str, str]:
    """Resolve the Bash adapter without printing credentials."""
    environment = os.environ.copy()
    if environment.get("FIRECRAWL_RESEARCH_AUTO_ENV", "1") != "1":
        return environment
    adapter = os.path.join(SCRIPT_DIR, "research-env")
    if not os.path.isfile(adapter):
        return environment
    result = subprocess.run(
        ["bash", "-c", 'source "$1"; env -0', "research-env", adapter],
        check=True,
        capture_output=True,
    )
    return {
        key.decode(errors="surrogateescape"): value.decode(errors="surrogateescape")
        for entry in result.stdout.split(b"\0")
        if entry
        for key, value in [entry.split(b"=", 1)]
    }


# ---------------------------------------------------------------------------
# Coloured output helpers
# ---------------------------------------------------------------------------

CYAN = "\033[1;36m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
RED = "\033[1;31m"
BOLD = "\033[1m"
RESET = "\033[0m"


# ---------------------------------------------------------------------------
# Legacy compatibility helpers (retained for tests and orchestrator compat)
# ---------------------------------------------------------------------------


def extract_keywords(topic: str) -> list[str]:
    """Extract search-relevant keywords from a topic string."""
    words = []
    for w in topic.lower().split():
        clean_w = "".join(c for c in w if c.isalnum() or c in "-_")
        if clean_w and clean_w not in {
            "the",
            "a",
            "an",
            "is",
            "of",
            "on",
            "for",
            "with",
            "in",
            "to",
            "how",
            "what",
            "why",
            "run",
            "setup",
            "get",
            "using",
            "by",
            "from",
            "and",
            "or",
            "about",
            "at",
            "but",
            "if",
            "not",
            "out",
            "up",
            "some",
            "any",
            "now",
            "focus",
            "vs",
            "versus",
            "difference",
            "between",
            "compare",
            "comparing",
            "pipeline",
            "related",
            "ongoing",
            "current",
            "package",
            "command",
            "aspect",
            "use",
            "where",
            "which",
            "who",
            "whom",
            "this",
            "that",
            "these",
            "those",
        }:
            words.append(clean_w)
    return words


def canonical_url(url: str) -> str:
    """Normalize a URL for deduplication."""
    try:
        parts = urlsplit(url)
        return urlunsplit(
            (
                parts.scheme.lower(),
                parts.netloc.lower(),
                parts.path.rstrip("/"),
                parts.query,
                "",
            )
        )
    except Exception:  # noqa: BLE001
        return url


def select_candidates(
    master_results: list[dict],
    total_scrapes: int,
    per_domain_cap: int | None = None,
) -> tuple[list[dict], list[dict]]:
    """Select a diverse global scrape set from already-acquired branch ledgers.

    Retained for test compatibility and orchestrator fallback paths.
    """
    by_url: dict[str, dict] = {}
    for result in master_results:
        facet = result.get("facet", "focused_detail")
        for candidate in result["metadata"].get("candidates", []):
            key = canonical_url(candidate.get("url", ""))
            if not key:
                continue
            record = by_url.setdefault(
                key, dict(candidate, branches=[], facets=[], occurrences=[])
            )
            branch = result["query_index"]
            rank = candidate.get("rank", 999)
            if branch not in record["branches"]:
                record["branches"].append(branch)
            if facet not in record["facets"]:
                record["facets"].append(facet)
            record["occurrences"].append({"branch": branch, "rank": rank})

    candidates = list(by_url.values())
    for record in candidates:
        ranks = [item["rank"] for item in record["occurrences"]]
        record["selection_score"] = round(
            sum(1.0 / (20 + rank) for rank in ranks)
            + 0.025 * (len(record["branches"]) - 1)
            + 0.01 * (len(record["facets"]) - 1),
            6,
        )
        record["best_rank"] = min(ranks)

    candidates.sort(
        key=lambda item: (
            -item["selection_score"],
            item["best_rank"],
            item.get("url", ""),
        )
    )
    if total_scrapes == 0:
        return candidates, []
    domain_cap = per_domain_cap or max(2, (total_scrapes + 5) // 6)
    domain_counts: dict[str, int] = {}
    selected: list[dict] = []
    deferred: list[dict] = []
    for record in candidates:
        domain = urlsplit(record.get("url", "")).netloc.lower()
        if domain and domain_counts.get(domain, 0) >= domain_cap:
            deferred.append(record)
            continue
        selected.append(record)
        domain_counts[domain] = domain_counts.get(domain, 0) + 1
        if len(selected) >= total_scrapes:
            break
    if len(selected) < total_scrapes:
        selected_urls = {canonical_url(item.get("url", "")) for item in selected}
        for record in deferred:
            if canonical_url(record.get("url", "")) not in selected_urls:
                selected.append(record)
            if len(selected) >= total_scrapes:
                break
    return candidates, selected


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "fsearch_smart — coverage-led research acquisition via "
            "the ResearchOrchestrator. Legacy flags are accepted for "
            "CLI compatibility but have no effect."
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("topic", help="The search topic or research objective")

    # Legacy / compatibility flags (no-op, retained for backward compatibility)
    parser.add_argument(
        "-c",
        "--complexity",
        choices=["simple", "moderate", "complex", "auto"],
        default="auto",
        help=argparse.SUPPRESS,  # Hidden; no longer selects resources.
    )
    parser.add_argument(
        "--planner",
        choices=["auto", "gemini", "heuristic"],
        default="auto",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--llm",
        choices=["local", "openai", "gemini"],
        default="local",
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--model", help=argparse.SUPPRESS)
    parser.add_argument(
        "--commercial-fallback",
        choices=["openai", "gemini"],
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--fallback-model", help=argparse.SUPPRESS)
    parser.add_argument(
        "--research-profile",
        choices=[
            "auto",
            "general",
            "breaking_news",
            "legislative_legal",
            "technical_docs",
        ],
        default="auto",
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--no-llm-triage", action="store_true", help=argparse.SUPPRESS)

    # Orchestrator flag (no-op; orchestrator is now the only path)
    parser.add_argument(
        "--orchestrator",
        action="store_true",
        default=False,
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--orchestrator-max-cycles",
        type=int,
        default=None,
        help=argparse.SUPPRESS,
    )

    # User-limit flags (no-op; budget policy evaluation is handled by the orchestrator)
    parser.add_argument("--max-searches", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--max-scrapes", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--max-iterations", type=int, help=argparse.SUPPRESS)
    parser.add_argument(
        "--max-successful-extractions", type=int, help=argparse.SUPPRESS
    )
    parser.add_argument("--results-per-query", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--total-scrapes", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--per-domain-cap", type=int, help=argparse.SUPPRESS)

    # Active flags
    parser.add_argument(
        "--research-spec",
        help="Validated research-spec-v1 JSON file",
    )
    parser.add_argument(
        "--invocation-id",
        help="Reuse an existing fc_<uuid> ID instead of generating one",
    )
    parser.add_argument(
        "--research-run-id",
        default=os.environ.get("FIRECRAWL_RESEARCH_RUN_ID", ""),
        help="Link this operation to an explicit fr_<uuid> research run",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Generate and print the search plan without running acquisition",
    )
    parser.add_argument(
        "--tbs",
        default="",
        help=argparse.SUPPRESS,  # Retained for CLI compatibility; handled by fsearch subcommand.
    )
    parser.add_argument(
        "--profile",
        choices=[
            "ecommerce",
            "forum",
            "news_article",
            "media_release",
            "academic_debate",
        ],
        help=argparse.SUPPRESS,
    )
    return parser


# ---------------------------------------------------------------------------
# Spec loading
# ---------------------------------------------------------------------------


def load_spec(
    args: argparse.Namespace, topic: str, research_env: dict[str, str]
) -> tuple[ResearchSpec, str]:
    """Load a ResearchSpec from --research-spec or generate a conservative fallback."""
    if args.research_spec:
        spec = load_model(
            json.loads(Path(args.research_spec).read_text(encoding="utf-8"))
        )
        if not isinstance(spec, ResearchSpec):
            raise SystemExit("--research-spec must contain research-spec-v1")
        return spec, "explicit"

    # Generate a conservative spec from the objective.
    # The profile is determined by the orchestrator via ResearchSpec;
    # legacy first-match profile detection is retired (P7-08).
    spec = conservative_research_spec(topic, "general")
    return spec, "deterministic conservative fallback"


# ---------------------------------------------------------------------------
# Search-plan generation
# ---------------------------------------------------------------------------


def generate_search_plan(
    topic: str,
    llm_provider: str = "local",
    llm_model: str | None = None,
    commercial_fallback: str | None = None,
    fallback_model: str | None = None,
) -> tuple[list[dict[str, str]], dict[str, str], dict[str, str]]:
    """Generate a structured search plan via LLM planning.

    Returns (search_plan, planner_provenance, brief_provenance).
    Falls back to a single conservative query when LLM planning is unavailable.
    """
    research_brief = workflow.conservative_brief(topic, "general")
    brief_provenance = {"status": "not_run", "provider": "deterministic"}

    search_plan, planner_provenance = workflow.plan_queries(
        topic,
        research_brief,
        3,
        llm_provider,
        llm_model,
        commercial_fallback,
        fallback_model,
    )

    if search_plan:
        return search_plan, planner_provenance, brief_provenance

    # Degraded: single exact-objective query.
    search_plan = [
        {
            "query": topic,
            "facet": "degraded_exact_objective",
            "subquestion": topic,
            "intended_source_class": "unspecified",
            "expected_organizations": [],
            "freshness_requirement": research_brief.get("time_window", "as stated"),
            "domain_neutral": True,
            "expected_contribution": "direct results for the exact objective",
        }
    ]
    planner_provenance = {
        **planner_provenance,
        "status": "degraded",
        "fallback": "exact_objective_only",
    }
    return search_plan, planner_provenance, brief_provenance


# ---------------------------------------------------------------------------
# Research-run creation (when --research-run-id is not provided)
# ---------------------------------------------------------------------------


def ensure_research_run(
    run_id: str,
    topic: str,
    research_env: dict[str, str],
) -> str:
    """Ensure a research run exists; create one via frun start if needed.

    Returns the (possibly generated) run ID.
    """
    if run_id:
        return run_id

    # Create a research run via frun start.
    result = subprocess.run(
        [os.path.join(SCRIPT_DIR, "frun"), "start", topic, "--profile", "auto"],
        env=research_env,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise SystemExit(
            "failed to create research run: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    return result.stdout.strip()


# ---------------------------------------------------------------------------
# Scratch-file compatibility output
# ---------------------------------------------------------------------------


def write_scratch_compat(
    invocation_id: str,
    base_dir: str,
    spec: ResearchSpec,
    budget_snapshot: dict,
    search_plan: list[dict],
    planner_provenance: dict,
    brief_provenance: dict,
) -> str:
    """Write legacy-compatible scratch files for backward compatibility.

    Returns the master metadata path.
    """
    os.makedirs(base_dir, exist_ok=True)

    spec_path = os.path.join(base_dir, "_research_spec.json")
    budget_path = os.path.join(base_dir, "_budget.json")

    with open(spec_path, "w", encoding="utf-8") as fh:
        json.dump(serialize_model(spec), fh, indent=2, sort_keys=True)
    with open(budget_path, "w", encoding="utf-8") as fh:
        json.dump(budget_snapshot, fh, indent=2, sort_keys=True)

    master_meta = {
        "invocation_id": invocation_id,
        "operation": "smart_search",
        "topic": None,  # Filled by caller
        "complexity": "auto",  # Legacy diagnostic; no longer used.
        "research_spec": serialize_model(spec),
        "budget_snapshot": budget_snapshot,
        "planner": "orchestrator",
        "planner_provenance": planner_provenance,
        "research_brief": None,  # Filled by caller
        "brief_provenance": brief_provenance,
        "query_plan": search_plan,
        "strategy": {
            "acquisition_mode": "coverage_led_orchestrator",
        },
        "base_dir": base_dir,
    }
    master_meta_path = os.path.join(base_dir, "_meta.json")
    with open(master_meta_path, "w") as fh:
        json.dump(master_meta, fh, indent=2)

    return master_meta_path


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    topic = args.topic

    # Resolve research environment.
    research_env = resolved_research_environment()
    persistence_mode = research_env.get("FIRECRAWL_RESEARCH_PERSIST", "auto")
    if persistence_mode not in {"auto", "on", "off"}:
        parser.error("FIRECRAWL_RESEARCH_PERSIST must be auto, on, or off")

    # Validate adapter mode.
    adapter_mode = research_env.get("FIRECRAWL_LEGACY_ADAPTER_MODE", "compatibility")
    if adapter_mode not in {"compatibility", "shadow", "authoritative"}:
        parser.error(
            "FIRECRAWL_LEGACY_ADAPTER_MODE must be compatibility, shadow, "
            "or authoritative"
        )
    if adapter_mode != "compatibility":
        if not research_env.get("DATABASE_URL"):
            parser.error(f"{adapter_mode} adapter mode requires DATABASE_URL")
        ready = subprocess.run(
            [os.path.join(SCRIPT_DIR, "research-db"), "ingest-ready"],
            env=research_env,
            check=False,
            capture_output=True,
            text=True,
        )
        if ready.returncode:
            parser.error(
                "legacy adapter database is not ready: "
                + (ready.stderr.strip() or ready.stdout.strip())
            )

    # Resolve invocation ID.
    try:
        invocation_id = resolve_invocation_id(args.invocation_id)
    except ValueError as exc:
        parser.error(str(exc))

    # Load spec.
    try:
        spec, spec_provenance = load_spec(args, topic, research_env)
    except SystemExit:
        raise
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        parser.error(f"invalid ResearchSpec: {exc}")

    # ---------------------------------------------------------------------------
    # DRY-RUN: check BEFORE any LLM calls or subprocess invocations.
    # ---------------------------------------------------------------------------
    if args.dry_run:
        research_brief = workflow.conservative_brief(topic, "general")
        search_plan = [
            {
                "query": topic,
                "facet": "degraded_exact_objective",
                "subquestion": topic,
                "intended_source_class": "unspecified",
                "expected_organizations": [],
                "freshness_requirement": research_brief.get("time_window", "as stated"),
                "domain_neutral": True,
                "expected_contribution": "direct results for the exact objective",
            }
        ]
        planner_provenance = {"status": "degraded", "fallback": "exact_objective_only"}
        brief_provenance = {"status": "not_run", "provider": "deterministic"}

        try:
            budget_snapshot = DEFAULT_POLICY.evaluate(
                spec,
                spec_revision=1,
                run_revision=0,
                user_limits={},
            )
            budget_dict = budget_snapshot.to_dict()
        except Exception:  # noqa: BLE001
            budget_dict = {
                "policy_version": DEFAULT_POLICY.version,
                "selected_tier": "standard",
                "effective_caps": {
                    "max_search_branches": 3,
                    "results_per_branch": 25,
                    "max_extraction_attempts": 12,
                    "max_successful_extractions": 6,
                    "max_adaptive_cycles": 10,
                },
            }

        tmp_base = os.environ.get("TMPDIR") or tempfile.gettempdir()
        invocation_dir = os.path.join(tmp_base, "firecrawl_scratch", invocation_id)
        base_dir = os.path.join(invocation_dir, "smart")
        master_meta_path = write_scratch_compat(
            invocation_id,
            base_dir,
            spec,
            budget_dict,
            search_plan,
            planner_provenance,
            brief_provenance,
        )
        with open(master_meta_path) as fh:
            meta = json.load(fh)
        meta["topic"] = topic
        meta["research_brief"] = brief_provenance.get("brief", {})
        with open(master_meta_path, "w") as fh:
            json.dump(meta, fh, indent=2)

        print(
            json.dumps(
                {
                    "topic": topic,
                    "invocation_id": invocation_id,
                    "research_spec": serialize_model(spec),
                    "budget_snapshot": budget_dict,
                    "planner": "orchestrator",
                    "planner_provenance": planner_provenance,
                    "research_brief": brief_provenance,
                    "brief_provenance": brief_provenance,
                    "strategy": {
                        "acquisition_mode": "coverage_led_orchestrator",
                    },
                    "queries": search_plan,
                },
                indent=2,
            )
        )
        catalog.begin(
            invocation_id,
            "smart_search",
            {
                "topic": topic,
                "planner": "orchestrator",
                "budget_policy_version": budget_dict.get("policy_version", ""),
                "budget_snapshot": budget_dict,
                "orchestrator": True,
            },
            None,
        )
        catalog.complete(invocation_id, "completed", master_meta_path)
        return 0

    # ---------------------------------------------------------------------------
    # Normal execution path (LLM calls and subprocess invocations follow).
    # ---------------------------------------------------------------------------

    # Generate search plan via LLM planning.
    search_plan, planner_provenance, brief_provenance = generate_search_plan(topic)

    # Budget evaluation is handled by the orchestrator internally.
    # We still evaluate it here for scratch-file compatibility output.
    try:
        budget_snapshot = DEFAULT_POLICY.evaluate(
            spec,
            spec_revision=1,
            run_revision=0,
            user_limits={},
        )
        budget_dict = budget_snapshot.to_dict()
    except Exception:  # noqa: BLE001
        # Budget evaluation may fail in non-persistence mode; use a minimal dict.
        budget_dict = {
            "policy_version": DEFAULT_POLICY.version,
            "selected_tier": "standard",
            "effective_caps": {
                "max_search_branches": 3,
                "results_per_branch": 25,
                "max_extraction_attempts": 12,
                "max_successful_extractions": 6,
                "max_adaptive_cycles": 10,
            },
        }

    # Ensure research run exists.
    run_id = args.research_run_id or ""
    try:
        run_id = ensure_research_run(run_id, topic, research_env)
    except SystemExit:
        raise
    except Exception:  # noqa: BLE001
        # If frun start fails (no database), fall back to scratch-only mode.
        run_id = ""

    # Catalog begin.
    catalog.begin(
        invocation_id,
        "smart_search",
        {
            "topic": topic,
            "planner": "orchestrator",
            "budget_policy_version": budget_dict.get("policy_version", ""),
            "budget_snapshot": budget_dict,
            "orchestrator": True,
        },
        run_id or None,
    )

    # Print header.
    print(f"{CYAN}=== Smart Search Orchestrator ==={RESET}")
    print(f"{BOLD}Topic:{RESET}       {topic}")
    print(f"{BOLD}Invocation:{RESET}  {invocation_id}")
    if run_id:
        print(f"{BOLD}Run ID:{RESET}      {run_id}")
    print(
        f"{BOLD}Budget:{RESET}      {budget_dict.get('policy_version', 'unknown')} / {budget_dict.get('selected_tier', 'unknown')} ({spec_provenance})"
    )
    print(f"{BOLD}Strategy:{RESET}    coverage-led orchestrator")
    print()

    # Print search plan.
    print(f"{BOLD}Generated Search Plan:{RESET}")
    for idx, entry in enumerate(search_plan, 1):
        print(
            f"  {idx}. {CYAN}{entry.get('query', '')}{RESET} [{entry.get('facet', '')}]"
        )
    print()

    # --- Orchestrator execution (default and only path) ----------------
    if not run_id:
        # No research run available; fall back to scratch-only output.
        tmp_base = os.environ.get("TMPDIR") or tempfile.gettempdir()
        invocation_dir = os.path.join(tmp_base, "firecrawl_scratch", invocation_id)
        base_dir = os.path.join(invocation_dir, "smart")
        master_meta_path = write_scratch_compat(
            invocation_id,
            base_dir,
            spec,
            budget_dict,
            search_plan,
            planner_provenance,
            brief_provenance,
        )
        with open(master_meta_path) as fh:
            meta = json.load(fh)
        meta["topic"] = topic
        meta["research_brief"] = brief_provenance.get("brief", {})
        with open(master_meta_path, "w") as fh:
            json.dump(meta, fh, indent=2)

        print(
            f"{YELLOW}WARNING: orchestrator unavailable (no research run); scratch-only output.{RESET}"
        )
        print(f"✔ Scratch-compatible metadata generated at: {GREEN}{base_dir}{RESET}")
        print(f"✔ Unified JSON meta generated at: {GREEN}{master_meta_path}{RESET}")
        catalog.complete(invocation_id, "completed", master_meta_path)
        return 0

    try:
        from research_store.config import StoreConfig
        from research_store.orchestrator import (
            OrchestratorConfig,
            ResearchOrchestrator,
        )

        orchestrator_config = OrchestratorConfig(
            execution_mode="autonomous_local",
            budget_policy_version=budget_dict.get(
                "policy_version", DEFAULT_POLICY.version
            ),
            max_adaptive_cycles=(
                args.orchestrator_max_cycles
                if args.orchestrator_max_cycles is not None
                else 10
            ),
            legacy_adapter_mode=adapter_mode,
        )
        orchestrator = ResearchOrchestrator.build(
            StoreConfig.from_env(),
            orchestrator_config=orchestrator_config,
        )
        result = orchestrator.run_from_external_id(
            run_id,
            spec=serialize_model(spec),
            search_plan={
                "schema_version": "search-plan-v1",
                "research_spec_id": str(spec.research_spec_id),
                "revision": 1,
                "queries": search_plan,
            },
            max_adaptive_cycles=orchestrator_config.max_adaptive_cycles,
        )

        print(f"Orchestrator outcome: {result.outcome}")
        print(f"Final state: {result.final_state}")
        print(f"Wave count: {result.wave_count}")
        print(f"Successful URLs: {result.successful_urls}")
        if result.error:
            print(f"{RED}Error: {result.error}{RESET}")
            catalog.complete(invocation_id, "failed", error=result.error)
            return 1

        catalog.complete(invocation_id, result.outcome)
        return 0

    except Exception as exc:
        print(f"{RED}Orchestrator failed: {exc}{RESET}")
        catalog.complete(invocation_id, "failed", error=str(exc))
        raise


if __name__ == "__main__":
    raise SystemExit(main())
