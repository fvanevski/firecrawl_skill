#!/usr/bin/env python3
"""Deprecated compatibility alias for ``fresearch run``.

This file intentionally contains no planning, lifecycle, budget, or recovery
policy.  It is retained only through the epic #309 migration and is removed at
the next breaking command-surface release.
"""

from __future__ import annotations

import sys

from firecrawl_skill.research_store.research_controller_cli import main as fresearch_main


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    return fresearch_main(["run", *args])


if __name__ == "__main__":
    raise SystemExit(main())
