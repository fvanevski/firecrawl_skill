#!/usr/bin/env python3
# fsearch_smart — coverage-led PostgreSQL-authoritative research orchestrator
#
# Usage:
#   fsearch_smart "<topic>" [--research-spec spec.json] [--research-run-id fr_<uuid>]
#
# Dry-run emits a deterministic plan to stdout only. Normal execution persists
# workflow, acquisition, provenance, corpus, and job state through PostgreSQL.

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path
from typing import Any

SCRIPT_DIR = os.environ.get("FIRECRAWL_SKILL_SCRIPT_DIR") or os.path.dirname(
    os.path.realpath(__file__)
)
sys.path.insert(0, SCRIPT_DIR)

import research_workflow as workflow
from budget_policy import DEFAULT_POLICY, conservative_research_spec
from invocation_id import resolve_invocation_id
from research_domain import load_model, serialize_model
from research_domain.models import ResearchSpec

CYAN = "\033[1;36m"
RED = "\033[1;31m"
BOLD = "\033[1m"
RESET = "\033[0m"


def resolved_research_environment() -> dict[str, str]:
    """Resolve the Bash environment adapter without printing credentials."""
    environment = os.environ.copy()
    if environment.get("FIRECRAWL_RESEARCH_AUTO_ENV", "1") != "1":
        return environment
    adapter = os.path.join(SCRIPT_DIR, "research-env")
    if not os.path.isfile(adapter):
        return environment
    result = subprocess.run(
        ["bash", "-c", 'source "$1"; env -0', "research-env", adapter],
        check=True,
        capture_output=True,
    )
    return {
        key.decode(errors="surrogateescape"): value.decode(errors="surrogateescape")
        for entry in result.stdout.split(b"\0")
        if entry
        for key, value in [entry.split(b"=", 1)]
    }


@contextmanager
def applied_environment(environment: dict[str, str]):
    """Apply the resolved adapter environment for in-process store clients."""
    previous = os.environ.copy()
    os.environ.clear()
    os.environ.update(environment)
    try:
        yield
    finally:
        os.environ.clear()
        os.environ.update(previous)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "fsearch_smart — coverage-led research acquisition via "
            "the PostgreSQL-authoritative ResearchOrchestrator."
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("topic", help="The search topic or research objective")
    parser.add_argument(
        "--research-spec",
        help="Validated research-spec-v1 JSON file",
    )
    parser.add_argument(
        "--invocation-id",
        help="Reuse an existing fc_<uuid> ID instead of generating one",
    )
    parser.add_argument(
        "--research-run-id",
        default=os.environ.get("FIRECRAWL_RESEARCH_RUN_ID", ""),
        help="Link this operation to an explicit fr_<uuid> research run",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print a deterministic search plan without persistence or acquisition",
    )
    parser.add_argument(
        "--max-adaptive-cycles",
        type=int,
        default=None,
        help=(
            "Tighten the policy-authorized adaptive-cycle cap for this run; "
            "values above the policy cap are rejected"
        ),
    )
    return parser


def load_spec(
    args: argparse.Namespace,
    topic: str,
) -> tuple[ResearchSpec, str]:
    """Load an explicit ResearchSpec or generate the conservative fallback."""
    if args.research_spec:
        spec = load_model(
            json.loads(Path(args.research_spec).read_text(encoding="utf-8"))
        )
        if not isinstance(spec, ResearchSpec):
            raise SystemExit("--research-spec must contain research-spec-v1")
        return spec, "explicit"
    return conservative_research_spec(topic, "general"), (
        "deterministic conservative fallback"
    )


def evaluate_budget(spec: ResearchSpec) -> dict[str, Any]:
    """Evaluate the local policy without external calls."""
    try:
        return DEFAULT_POLICY.evaluate(
            spec,
            spec_revision=1,
            run_revision=0,
            user_limits={},
        ).to_dict()
    except Exception:  # noqa: BLE001
        return {
            "policy_version": DEFAULT_POLICY.version,
            "selected_tier": "standard",
            "effective_caps": {
                "max_search_branches": 3,
                "results_per_branch": 25,
                "max_extraction_attempts": 12,
                "max_successful_extractions": 6,
                "max_adaptive_cycles": 10,
            },
        }


def deterministic_plan(
    topic: str,
) -> tuple[list[dict[str, Any]], dict[str, Any], dict[str, Any], dict[str, Any]]:
    """Return the side-effect-free dry-run plan."""
    research_brief = workflow.conservative_brief(topic, "general")
    search_plan = [
        {
            "query": topic,
            "facet": "degraded_exact_objective",
            "subquestion": topic,
            "intended_source_class": "unspecified",
            "expected_organizations": [],
            "freshness_requirement": research_brief.get("time_window", "as stated"),
            "domain_neutral": True,
            "expected_contribution": "direct results for the exact objective",
        }
    ]
    planner_provenance = {
        "status": "degraded",
        "fallback": "exact_objective_only",
    }
    brief_provenance = {
        "status": "not_run",
        "provider": "deterministic",
    }
    return search_plan, planner_provenance, research_brief, brief_provenance


def generate_search_plan(
    topic: str,
    max_queries: int = 3,
) -> tuple[list[dict[str, Any]], dict[str, Any], dict[str, Any]]:
    """Generate a bounded plan, falling back to the exact objective."""
    research_brief = workflow.conservative_brief(topic, "general")
    brief_provenance = {"status": "not_run", "provider": "deterministic"}
    search_plan, planner_provenance = workflow.plan_queries(
        topic,
        research_brief,
        max_queries,
        "local",
        None,
        None,
        None,
    )
    if search_plan:
        return search_plan, planner_provenance, brief_provenance

    search_plan, fallback_provenance, _brief, _brief_provenance = (
        deterministic_plan(topic)
    )
    planner_provenance = {
        **planner_provenance,
        **fallback_provenance,
    }
    return search_plan, planner_provenance, brief_provenance


def resolve_max_adaptive_cycles(
    requested: int | None,
    budget_snapshot: dict[str, Any],
    parser: argparse.ArgumentParser,
) -> int:
    """Resolve a caller-supplied cycle ceiling against the policy cap."""
    policy_cap = int(
        budget_snapshot.get("effective_caps", {}).get("max_adaptive_cycles", 10)
    )
    if requested is None:
        return policy_cap
    if requested < 1:
        parser.error("--max-adaptive-cycles must be at least 1")
    if requested > policy_cap:
        parser.error(
            "--max-adaptive-cycles cannot exceed the policy-authorized cap "
            f"({policy_cap})"
        )
    return requested


def ensure_research_run(
    run_id: str,
    topic: str,
    research_env: dict[str, str],
) -> str:
    """Return the explicit run or create one through the authoritative CLI."""
    if run_id:
        return run_id
    result = subprocess.run(
        [os.path.join(SCRIPT_DIR, "frun"), "start", topic],
        env=research_env,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise RuntimeError(
            "failed to create research run: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    return result.stdout.strip()


def prepare_authoritative_run(
    run_id: str,
    topic: str,
    research_env: dict[str, str],
):
    """Require a ready store, resolve the run, and validate acquisition authority."""
    if not research_env.get("DATABASE_URL"):
        raise RuntimeError(
            "fsearch_smart requires the authoritative PostgreSQL store; "
            "set DATABASE_URL"
        )

    ready = subprocess.run(
        [os.path.join(SCRIPT_DIR, "research-db"), "ingest-ready"],
        env=research_env,
        check=False,
        capture_output=True,
        text=True,
    )
    if ready.returncode:
        raise RuntimeError(
            "authoritative database is not ready: "
            + (ready.stderr.strip() or ready.stdout.strip())
        )

    resolved_run_id = ensure_research_run(run_id, topic, research_env)

    from research_store.acquisition_authority import (
        ACQUISITION_ENTRY_STATES,
        require_authoritative_acquisition,
    )
    from research_store.config import StoreConfig
    from research_store.container import build_run_service

    config = StoreConfig.from_env()
    config.require_database()
    status = build_run_service(config).status(external_id=resolved_run_id)
    if status.state in ACQUISITION_ENTRY_STATES:
        require_authoritative_acquisition(run_id=status.id, config=config)
    return resolved_run_id, config, status


def execute_orchestrator(
    run_id: str,
    spec: ResearchSpec,
    search_plan: list[dict[str, Any]],
    budget_dict: dict[str, Any],
    max_adaptive_cycles: int,
    store_config,
):
    """Execute or resume the authoritative orchestrator."""
    from research_store.orchestrator import (
        OrchestratorConfig,
        ResearchOrchestrator,
    )

    orchestrator_config = OrchestratorConfig(
        execution_mode="autonomous_local",
        budget_policy_version=budget_dict.get(
            "policy_version", DEFAULT_POLICY.version
        ),
        max_adaptive_cycles=max_adaptive_cycles,
    )
    orchestrator = ResearchOrchestrator.build(
        store_config,
        orchestrator_config=orchestrator_config,
    )
    return orchestrator.run_from_external_id(
        run_id,
        spec=serialize_model(spec),
        search_plan={
            "schema_version": "search-plan-v1",
            "research_spec_id": str(spec.research_spec_id),
            "revision": 1,
            "queries": search_plan,
        },
        max_adaptive_cycles=orchestrator_config.max_adaptive_cycles,
    )


def dry_run_payload(
    *,
    topic: str,
    invocation_id: str,
    spec: ResearchSpec,
    budget_dict: dict[str, Any],
    max_adaptive_cycles: int,
) -> dict[str, Any]:
    search_plan, planner_provenance, research_brief, brief_provenance = (
        deterministic_plan(topic)
    )
    return {
        "schema_version": "authoritative-smart-search-plan-v1",
        "mode": "dry_run",
        "topic": topic,
        "invocation_id": invocation_id,
        "research_spec": serialize_model(spec),
        "budget_snapshot": budget_dict,
        "planner": "orchestrator",
        "planner_provenance": planner_provenance,
        "research_brief": research_brief,
        "brief_provenance": brief_provenance,
        "strategy": {
            "acquisition_mode": "coverage_led_orchestrator",
            "max_adaptive_cycles": max_adaptive_cycles,
        },
        "queries": search_plan,
    }


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    topic = args.topic

    try:
        invocation_id = resolve_invocation_id(args.invocation_id)
    except ValueError as exc:
        parser.error(str(exc))

    try:
        spec, spec_provenance = load_spec(args, topic)
    except SystemExit:
        raise
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        parser.error(f"invalid ResearchSpec: {exc}")

    budget_dict = evaluate_budget(spec)
    max_adaptive_cycles = resolve_max_adaptive_cycles(
        args.max_adaptive_cycles,
        budget_dict,
        parser,
    )

    # Dry-run is intentionally resolved before environment sourcing, subprocess
    # execution, database access, model calls, or acquisition construction.
    if args.dry_run:
        print(
            json.dumps(
                dry_run_payload(
                    topic=topic,
                    invocation_id=invocation_id,
                    spec=spec,
                    budget_dict=budget_dict,
                    max_adaptive_cycles=max_adaptive_cycles,
                ),
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    try:
        research_env = resolved_research_environment()
    except (OSError, subprocess.SubprocessError) as exc:
        parser.error(f"failed to resolve research environment: {exc}")

    try:
        with applied_environment(research_env):
            run_id, store_config, run_status = prepare_authoritative_run(
                args.research_run_id or "",
                topic,
                research_env,
            )
            search_plan, planner_provenance, brief_provenance = (
                generate_search_plan(
                    topic,
                    max_queries=budget_dict.get("effective_caps", {}).get(
                        "max_search_branches", 3
                    ),
                )
            )

            print(f"{CYAN}=== Smart Search Orchestrator ==={RESET}")
            print(f"{BOLD}Topic:{RESET}       {topic}")
            print(f"{BOLD}Invocation:{RESET}  {invocation_id}")
            print(f"{BOLD}Run ID:{RESET}      {run_id}")
            print(f"{BOLD}Run state:{RESET}   {run_status.state}")
            print(
                f"{BOLD}Budget:{RESET}      "
                f"{budget_dict.get('policy_version', 'unknown')} / "
                f"{budget_dict.get('selected_tier', 'unknown')} "
                f"({spec_provenance})"
            )
            print(f"{BOLD}Strategy:{RESET}    coverage-led orchestrator")
            print()
            print(f"{BOLD}Generated Search Plan:{RESET}")
            for index, entry in enumerate(search_plan, 1):
                print(
                    f"  {index}. {CYAN}{entry.get('query', '')}{RESET} "
                    f"[{entry.get('facet', '')}]"
                )
            print()

            result = execute_orchestrator(
                run_id,
                spec,
                search_plan,
                budget_dict,
                max_adaptive_cycles,
                store_config,
            )
    except (RuntimeError, ValueError, OSError) as exc:
        parser.error(str(exc))
    except Exception as exc:
        print(f"{RED}Orchestrator failed: {exc}{RESET}", file=sys.stderr)
        raise

    print(f"Orchestrator outcome: {result.outcome}")
    print(f"Final state: {result.final_state}")
    print(f"Wave count: {result.wave_count}")
    print(f"Successful URLs: {result.successful_urls}")
    if result.error:
        print(f"{RED}Error: {result.error}{RESET}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
