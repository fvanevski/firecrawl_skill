#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=research-env
source "$script_dir/research-env"

research_python="${FIRECRAWL_RESEARCH_PYTHON:-}"
if [[ -z "$research_python" || ! -x "$research_python" ]]; then
  echo "ERROR: research-env did not provide an executable FIRECRAWL_RESEARCH_PYTHON" >&2
  exit 1
fi

exec "$research_python" -m firecrawl_skill.research_store.candidate_budget_cli "$@"
