#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SRC_DIR="$(cd -- "$SCRIPT_DIR/../src" && pwd -P)"
if [[ "${FIRECRAWL_RESEARCH_AUTO_ENV:-1}" == "1" && -r "$SCRIPT_DIR/research-env" ]]; then
  source "$SCRIPT_DIR/research-env"
fi
research_python="${FIRECRAWL_RESEARCH_PYTHON:-$(command -v python3)}"
export PYTHONPATH="$SRC_DIR:$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$research_python" -m firecrawl_skill.research_store.fsearch_cli "$@"
