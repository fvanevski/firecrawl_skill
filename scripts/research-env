#!/usr/bin/env bash
# Bash adapter sourced by the Firecrawl wrappers to bind dedicated services.
# Values remain file-backed; no secret is copied into the repository.
#
# Priority: explicit env vars > .env file > defaults / container secrets.
# Embedding identity is the exception: it is deployment-specific and must be
# supplied explicitly or by the root .env file.

research_skill_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
research_env_file="$research_skill_root/.env"

# ── Source root .env if present (allows local overrides) ─────────────────
# Load in a separate Bash process and import only variables that are not already
# defined in the caller. This preserves explicit-env precedence, keeps malformed
# files fail-closed, and avoids changing the caller's shell options.
if [[ -r "$research_env_file" ]]; then
  research_env_dump="$(mktemp "${TMPDIR:-/tmp}/firecrawl-research-env.XXXXXX")" || {
    echo "ERROR: unable to create temporary file for $research_env_file" >&2
    return 1 2>/dev/null || exit 1
  }
  if ! "$BASH" --noprofile --norc -ae -c \
    '. "$1"; env -0' bash "$research_env_file" > "$research_env_dump"; then
    rm -f "$research_env_dump"
    echo "ERROR: unable to load $research_env_file" >&2
    return 1 2>/dev/null || exit 1
  fi

  while IFS= read -r -d '' research_env_entry; do
    research_env_key="${research_env_entry%%=*}"
    research_env_value="${research_env_entry#*=}"
    if [[ "$research_env_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] &&
      [[ ! -v $research_env_key ]]; then
      printf -v "$research_env_key" '%s' "$research_env_value"
      export "$research_env_key"
    fi
  done < "$research_env_dump"
  rm -f "$research_env_dump"
fi

if [[ -n "${FIRECRAWL_RESEARCH_PYTHON:-}" ]]; then
  research_python="$FIRECRAWL_RESEARCH_PYTHON"
  if [[ ! -x "$research_python" ]]; then
    echo "ERROR: FIRECRAWL_RESEARCH_PYTHON is not executable: $research_python" >&2
    return 1 2>/dev/null || exit 1
  fi
elif [[ -x "$research_skill_root/.venv-research-store/bin/python" ]]; then
  research_python="$research_skill_root/.venv-research-store/bin/python"
else
  research_python="$(command -v python3 || true)"
  if [[ -z "$research_python" || ! -x "$research_python" ]]; then
    echo "ERROR: no executable research Python interpreter was found" >&2
    return 1 2>/dev/null || exit 1
  fi
fi

# Resolve runtime provenance before any authoritative database/provider operation.
# A bundled checkout is intentionally source-bound: an interpreter that naturally
# imports firecrawl_skill from another checkout/install is rejected rather than
# silently receiving PYTHONPATH surgery that would conceal the skew.
research_expected_package_root="$research_skill_root/src/firecrawl_skill"
if [[ ! -d "$research_expected_package_root" ]]; then
  echo "ERROR: expected firecrawl_skill source root is missing: $research_expected_package_root" >&2
  return 1 2>/dev/null || exit 1
fi
research_expected_package_root="$(cd -- "$research_expected_package_root" && pwd -P)"
research_python_resolved="$(command -v -- "$research_python" 2>/dev/null || printf '%s' "$research_python")"
research_actual_package_root="$("$research_python" -c '
from pathlib import Path
import firecrawl_skill
path = getattr(firecrawl_skill, "__file__", None)
if path is None:
    raise SystemExit("firecrawl_skill has no importable package file")
print(Path(path).resolve().parent)
' 2>/dev/null)" || {
  echo "ERROR: research runtime provenance check failed" >&2
  echo "  selected interpreter: $research_python_resolved" >&2
  echo "  expected source root: $research_expected_package_root" >&2
  echo "  actual imported package root: <unavailable>" >&2
  return 1 2>/dev/null || exit 1
}
if [[ "$research_actual_package_root" != "$research_expected_package_root" ]]; then
  echo "ERROR: research runtime provenance mismatch" >&2
  echo "  selected interpreter: $research_python_resolved" >&2
  echo "  expected source root: $research_expected_package_root" >&2
  echo "  actual imported package root: $research_actual_package_root" >&2
  return 1 2>/dev/null || exit 1
fi
export FIRECRAWL_RESEARCH_RUNTIME_ROOT="$research_actual_package_root"

research_postgres_dir="${RESEARCH_POSTGRES_DIR:-/opt/containers/research-postgres}"
research_qdrant_dir="${RESEARCH_QDRANT_DIR:-/opt/containers/research-qdrant}"
research_valkey_dir="${RESEARCH_VALKEY_DIR:-/opt/containers/research-valkey}"

research_urlencode() {
  "$research_python" -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.read().strip(), safe=""))'
}

if [[ -z "${DATABASE_URL:-}" && -r "$research_postgres_dir/secrets/research_postgres_password.txt" ]]; then
  research_pg_password="$(research_urlencode < "$research_postgres_dir/secrets/research_postgres_password.txt")"
  export DATABASE_URL="postgresql://${RESEARCH_POSTGRES_USER:-research_app}:${research_pg_password}@127.0.0.1:${RESEARCH_POSTGRES_PORT:-55432}/${RESEARCH_POSTGRES_DB:-research_assets}"
  unset research_pg_password
fi

if [[ -z "${QDRANT_API_KEY:-}" && -r "$research_qdrant_dir/secrets/research_qdrant_api_key.txt" ]]; then
  research_qdrant_api_key="$(tr -d '\r\n' < "$research_qdrant_dir/secrets/research_qdrant_api_key.txt")"
  export QDRANT_API_KEY="$research_qdrant_api_key"
  export QDRANT_URL="${QDRANT_URL:-http://127.0.0.1:${RESEARCH_QDRANT_HTTP_PORT:-6333}}"
  export QDRANT_COLLECTION="${QDRANT_COLLECTION:-research_chunks_v1}"
  unset research_qdrant_api_key
fi

if [[ -z "${VALKEY_URL:-}" && -r "$research_valkey_dir/secrets/research_valkey_password.txt" ]]; then
  research_valkey_password="$(research_urlencode < "$research_valkey_dir/secrets/research_valkey_password.txt")"
  export VALKEY_URL="redis://${RESEARCH_VALKEY_USER:-research_app}:${research_valkey_password}@127.0.0.1:${RESEARCH_VALKEY_PORT:-56379}/0"
  unset research_valkey_password
fi

export BLOB_ROOT="${BLOB_ROOT:-/opt/containers/research-assets/blobs}"
export EMBEDDING_URL="${EMBEDDING_URL:-http://127.0.0.1:8004/v1/embeddings}"
for research_embedding_key in \
  EMBEDDING_MODEL EMBEDDING_REVISION EMBEDDING_DIMENSION; do
  if [[ -z "${!research_embedding_key:-}" ]]; then
    echo "ERROR: $research_embedding_key must be set explicitly or in $research_env_file" >&2
    return 1 2>/dev/null || exit 1
  fi
done
if [[ ! "$EMBEDDING_DIMENSION" =~ ^[1-9][0-9]*$ ]]; then
  echo "ERROR: EMBEDDING_DIMENSION must be a positive integer" >&2
  return 1 2>/dev/null || exit 1
fi
export EMBEDDING_MODEL EMBEDDING_REVISION EMBEDDING_DIMENSION
export RERANKER_URL="${RERANKER_URL:-http://127.0.0.1:8004/v1/rerank}"
export RERANKER_MODEL="${RERANKER_MODEL:-rerank}"
export GENERATIVE_URL="${GENERATIVE_URL:-http://127.0.0.1:8004/v1}"
export GENERATIVE_MODEL="${GENERATIVE_MODEL:-chat}"
export QDRANT_ALIAS="${QDRANT_ALIAS:-research_chunks_active}"
export PARSER_VERSION="${PARSER_VERSION:-canonical-v1}"
export NORMALIZATION_VERSION="${NORMALIZATION_VERSION:-normalization-v1}"
export CHUNKER_VERSION="${CHUNKER_VERSION:-hierarchical-v1}"
export FIRECRAWL_RESEARCH_PYTHON="$research_python"

unset research_skill_root research_env_file research_env_dump research_env_entry
unset research_env_key research_env_value research_embedding_key research_python
unset research_postgres_dir research_qdrant_dir research_valkey_dir
unset research_expected_package_root research_actual_package_root research_python_resolved
unset -f research_urlencode
